{
  "name": "sudochatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/check-accounting.mjs",
    "check:ui": "tsx scripts/check-ui-hazards.mjs",
    "backup": "tsx scripts/backup-data.mjs",
    "backup:verify": "tsx scripts/verify-backup.mjs",
    "verify": "npm run typecheck && npm run check && npm run check:ui && npm run check:migrations && npm run check:actions && npm run build",
    "check:migrations": "tsx scripts/check-migrations.mjs",
    "check:actions": "tsx scripts/check-server-actions.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.515.0",
    "next": "^15.3.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
