{
  "name": "sudochatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "tsx scripts/check-accounting.mjs",
    "check:ui": "tsx scripts/check-ui-hazards.mjs",
    "backup": "tsx scripts/backup-data.mjs",
    "backup:verify": "tsx scripts/verify-backup.mjs",
    "verify": "npm run typecheck && npm run check && npm run check:ui && npm run check:migrations && npm run check:actions && npm run check:csv && npm run check:columns && npm run check:ailinks && npm run check:promptcache && npm run build",
    "check:migrations": "tsx scripts/check-migrations.mjs",
    "check:actions": "tsx scripts/check-server-actions.mjs",
    "check:csv": "tsx scripts/check-csv-import.mjs",
    "check:columns": "tsx scripts/check-column-map.mjs",
    "check:ailinks": "tsx scripts/check-ai-links.mjs",
    "check:models": "tsx scripts/check-ai-models.mjs",
    "e2e:assistant": "tsx scripts/assistant-readonly-e2e.mjs",
    "check:seo": "tsx scripts/check-seo.mjs",
    "line:menu": "tsx scripts/line-menu-deploy.mjs",
    "check:ready": "tsx scripts/check-ready.mjs",
    "check:ui:auth": "tsx scripts/check-logged-in-ui.mjs",
    "assistant-dryrun": "tsx scripts/assistant-dryrun.mjs",
    "check:accountant": "tsx scripts/check-accountant-file.mjs",
    "e2e": "playwright test",
    "e2e:public": "playwright test e2e/public-journeys.spec.ts",
    "e2e:ui": "playwright test --ui",
    "check:dupbuttons": "node scripts/find-duplicate-buttons.mjs",
    "app:sync": "cap sync",
    "app:android": "cap open android",
    "app:ios": "cap open ios",
    "app:build:android": "cd android && ANDROID_HOME=${ANDROID_HOME:-/opt/android-sdk} gradle assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../mobile/build/SudoChatBot-debug.apk",
    "check:promptcache": "tsx scripts/check-prompt-cache.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.515.0",
    "next": "^15.3.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
