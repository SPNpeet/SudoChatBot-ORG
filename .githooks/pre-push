#!/bin/sh
# ============================================================
#  ด่านก่อน push — ตัวเดียวที่ "บล็อกได้จริง" ไม่ใช่แค่คำเตือน
#
#  ทำไมต้องมี: 30 ก.ค. 2569 มีการอ้างว่า check-ui-hazards เป็น "CI/CD hard blocker"
#  ตรวจจริงแล้วไม่ใช่เลย — ไม่มี .github/workflows ไม่มี git hook ไม่มี husky
#  มันรันเฉพาะตอนที่คนจำได้ว่าต้องพิมพ์ npm run verify เท่านั้น
#  แปลว่ากติกาข้อ 6 ใน CLAUDE.md ยังเป็น "คำมั่นสัญญา" อยู่ ผิดกับหลักที่วางไว้เองว่า
#  "ถ้าต้องการให้หยุด ให้เขียน break อย่าเขียน prompt ขอ"
#
#  ทำไมไม่รัน build ในนี้: build ใช้ 36 วินาที แต่ 3 ด่านนี้ใช้ 5 วินาที
#  และ build มีคนตรวจให้อยู่แล้ว — Vercel build ไม่ผ่าน = ไม่ deploy ขึ้น production
#  ส่วน check (บัญชี/ภาษี) กับ check:ui ไม่มีใครรันให้เลยถ้าไม่รันที่นี่
#  ด่านที่ช้าจะถูกข้ามด้วย --no-verify แล้วก็ไร้ประโยชน์ ต้องเร็วพอที่จะไม่มีใครอยากข้าม
#
#  เปิดใช้ครั้งเดียวต่อ clone:  git config core.hooksPath .githooks
# ============================================================
set -e

echo ""
echo "== ด่านก่อน push =="

if ! npm run typecheck; then
  echo ""
  echo "  หยุด: typecheck ไม่ผ่าน — ห้าม push"
  exit 1
fi

if ! npm run check; then
  echo ""
  echo "  หยุด: ด่านบัญชี/ภาษีไม่ผ่าน — ห้าม push เพราะกระทบตัวเลขที่ลูกค้ายื่นสรรพากร"
  exit 1
fi

if ! npm run check:ui; then
  echo ""
  echo "  หยุด: ด่าน UI ไม่ผ่าน — ห้าม push"
  exit 1
fi

if ! npm run check:migrations; then
  echo ""
  echo "  หยุด: ลำดับ migration ไม่ผ่าน — clone ใหม่จะสร้างระบบขึ้นมาไม่ได้ ห้าม push"
  exit 1
fi

echo ""
echo "  ผ่าน 4 ด่าน (typecheck · บัญชี · UI · ลำดับ migration) — build จะถูกตรวจอีกรอบที่ Vercel"
echo ""
